# Public values only (EXPO_PUBLIC_* ends up in the app bundle). Copy to .env for local dev.
# RevenueCat PUBLIC iOS SDK key (starts with appl_). Never the secret key.
EXPO_PUBLIC_RC_IOS_KEY=
# Full URL of the deployed AI Worker (worker/ in this repo) including /chat.
# EAS builds get it from eas.json; this line is for local `npx expo start`.
EXPO_PUBLIC_AI_URL=
