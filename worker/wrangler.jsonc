{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "facerep-api",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  // Worker logs keep only what the code prints (outcomes, never question contents).
  "observability": { "enabled": true },
  // Workers AI: the fallback model runs on Cloudflare. The main model is Google's Gemini API (secret GEMINI_API_KEY,
  // on a Google project with billing on; src/lib/gemini.js).
  "ai": { "binding": "AI" },
  // The Premium exercises (drawings, clips, texts), built into .content/ by `npm run content` (runs before deploy and
  // dev). Private: every request runs the Worker first, and a file goes out only with a token from POST /content,
  // given after RevenueCat confirms Premium (src/lib/content.js).
  "assets": { "directory": "./.content", "binding": "CONTENT", "run_worker_first": true },
  "vars": {
    // Google Gemini ($0.30 / $2.50 per million tokens in / out at the time of writing). Without GEMINI_API_KEY the
    // fallback answers alone.
    "AI_MODEL": "gemini-3.5-flash-lite",
    // Workers AI, tried once when Gemini fails or times out ($0.10 / $0.30). It must support function calling.
    "AI_FALLBACK_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    "AI_MAX_OUTPUT_TOKENS": "700",
    // Shown on the public /privacy, /terms and /support pages. LEGAL_NAME is optional.
    "APP_NAME": "FaceRep",
    "LEGAL_NAME": "",
    "SUPPORT_EMAIL": "kindcodelabs@gmail.com",
    // Your 10-character Apple Team ID (developer.apple.com → Membership details). Used with the
    // DEVICECHECK_KEY and DEVICECHECK_KEY_ID secrets; see README "D. Premium and free limits".
    "APPLE_TEAM_ID": "Z43K3DU9C9"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "facerep-limits",
      // Created 2026-10-07 (tables from migrations/ already applied).
      "database_id": "8b211cca-6599-469c-a52b-f38b07662190",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": { "crons": ["17 3 * * *"] }
}
